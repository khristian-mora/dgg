	<meta name="generator" content="Elementor 3.22.3; features: e_optimized_assets_loading, e_optimized_css_loading, e_font_icon_svg, additional_custom_breakpoints; settings: css_print_method-external, google_font-disabled, font_display-swap">
<script>
document.addEventListener('DOMContentLoaded', () => {
    console.log('✅ Iniciando ajustes de accesibilidad...');

    const applyFixes = (target) => {
        // Inyectar etiquetas <label> para inputs sin atributos accesibles
        target.querySelectorAll('input:not([aria-label]):not([aria-labelledby]):not([title]):not([id])').forEach((el, index) => {
            if (!el.id) el.id = 'temp-injected-id-' + index;

            let label = document.createElement('label');
            label.setAttribute('for', el.id);
            label.textContent = 'Campo automático ' + (index + 1);

            el.parentNode.insertBefore(label, el);
            console.log(`🏷️ Etiqueta <label> agregada: ${label.outerHTML}`);
        });

        // Corregir inputs y checkboxes dentro de <label>
        target.querySelectorAll('.mdp-readabler-switch-box input[type="checkbox"]').forEach((el, index) => {
            if (!el.hasAttribute('aria-label')) {
                const parentLabel = el.closest('.mdp-switch')?.textContent.trim() || 'Sin descripción';
                el.setAttribute('aria-label', `Opción ${index + 1}: ${parentLabel}`);
                console.log(`✅ Atributo aria-label agregado al input: ${el.outerHTML}`);
            }
        });
    };

    const simplifyUI = () => {
        // Simplificar la interfaz dejando solo checkbox y texto
        document.querySelectorAll('.mdp-readabler-switch-box').forEach((container, index) => {
            const checkbox = container.querySelector('input[type="checkbox"]');
            const parentLabelText = container.closest('.mdp-readabler-accessibility-profile-item')?.querySelector('.mdp-readabler-profile-title')?.textContent.trim() || `Opción ${index + 1}`;

            if (checkbox) {
                // Crear un contenedor para checkbox y texto
                const labelContainer = document.createElement('label');
                labelContainer.setAttribute('for', checkbox.id || `temp-injected-id-${index}`);
                labelContainer.textContent = parentLabelText;

                // Asegurar que el checkbox tenga un ID único
                if (!checkbox.id) checkbox.id = `temp-injected-id-${index}`;

                // Limpiar el contenedor y agregar el checkbox con texto
                container.innerHTML = '';
                container.appendChild(checkbox);
                container.appendChild(labelContainer);

                console.log(`✅ Checkbox con texto agregado: ${labelContainer.outerHTML}`);
            } else {
                console.log(`⏩ No se encontró checkbox en el contenedor: ${container.outerHTML}`);
            }
        });
    };

    // Aplicar ajustes al cargar inicialmente
    applyFixes(document);
    simplifyUI();

    // Observar el popup para ajustes dinámicos
    const popupObserver = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
            if (mutation.addedNodes) {
                mutation.addedNodes.forEach((node) => {
                    if (node.nodeType === Node.ELEMENT_NODE && node.id === 'mdp-readabler-popup') {
                        console.log('🎯 Popup detectado, aplicando ajustes...');
                        applyFixes(node);
                        simplifyUI();
                    }
                });
            }
        });
    });

    // Observar cambios en el cuerpo para detectar el popup
    popupObserver.observe(document.body, { childList: true, subtree: true });

    console.log('🟢 Ajustes combinados completados.');
});
</script>
