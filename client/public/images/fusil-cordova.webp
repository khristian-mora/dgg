<script src="https://www.indumil.gov.co/wp-content/plugins/elementor/assets/js/frontend.js?ver=3.22.3" id="elementor-frontend-js"></script>
<script src="https://www.indumil.gov.co/wp-content/plugins/elementor-pro/assets/js/elements-handlers.js?ver=3.22.1" id="pro-elements-handlers-js"></script>
<script src="https://www.indumil.gov.co/wp-includes/js/underscore.min.js?ver=1.13.7" id="underscore-js"></script>
