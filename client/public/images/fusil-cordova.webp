		<div class="elementor-element elementor-element-7275f5a3 e-con-full e-flex e-con e-child" data-id="7275f5a3" data-element_type="container">
				<div class="elementor-element elementor-element-17bd5451 elementor-widget elementor-widget-html" data-id="17bd5451" data-element_type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
			<!-- ============================================================
     INDUMIL — Menú de Navegación Principal
     Versión mejorada: Desktop Mega-Menú + Mobile Hamburguesa
     WCAG 2.1 AA | Resolución 1519/2020 | Mobile-First
     ============================================================ -->
     <script>
(function () {
 'use strict';

  /* ── Función principal que inicializa el menú ────────────── */
  function initIndumilMenu() {

    var toggle   = document.getElementById('nav-toggle');
    var navList  = document.getElementById('nav-menu');
    var overlay  = document.getElementById('nav-overlay');

    /* Si no encuentra los elementos, sale sin error */
    if (!toggle || !navList || !overlay) {
      console.warn('INDUMIL Menú: elementos no encontrados. Reintentando...');
      return false;
    }

    var navItems = document.querySelectorAll('.indumil-nav .nav-item');

    /* ── Abre el cajón lateral ─────────────────────────────── */
    function openMenu() {
      navList.classList.add('is-open');
      overlay.classList.add('is-active');
      overlay.style.display = 'block';
      overlay.style.opacity = '1';
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú');
      document.body.style.overflow = 'hidden';
    }

    /* ── Cierra el cajón lateral ───────────────────────────── */
    function closeMenu() {
      navList.classList.remove('is-open');
      overlay.classList.remove('is-active');
      overlay.style.opacity = '0';
      setTimeout(function () {
        if (!overlay.classList.contains('is-active')) {
          overlay.style.display = 'none';
        }
      }, 300);
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú de navegación');
      document.body.style.overflow = '';

      /* Cierra todos los acordeones */
      navItems.forEach(function (item) {
        item.classList.remove('is-open');
        var link = item.querySelector('.nav-link');
        if (link) link.setAttribute('aria-expanded', 'false');
      });
    }

    /* ── Toggle hamburguesa ────────────────────────────────── */
    toggle.addEventListener('click', function (e) {
      e.stopPropagation();
      if (navList.classList.contains('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    /* ── Cierra al hacer clic en overlay ───────────────────── */
    overlay.addEventListener('click', closeMenu);

    /* ── Tecla Escape ──────────────────────────────────────── */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && navList.classList.contains('is-open')) {
        closeMenu();
        toggle.focus();
      }
    });

    /* ── Acordeón mobile ───────────────────────────────────── */
    navItems.forEach(function (item) {
      var link  = item.querySelector('.nav-link');
      var panel = item.querySelector('.mega-panel');

      if (!link || !panel) return;

      link.addEventListener('click', function (e) {
        /* En desktop el hover CSS lo maneja — no interceptar */
        if (window.innerWidth >= 1024) return;

        e.preventDefault();
        e.stopPropagation();

        var isOpen = item.classList.contains('is-open');

        /* Cierra todos los demás */
        navItems.forEach(function (other) {
          if (other !== item) {
            other.classList.remove('is-open');
            var otherLink = other.querySelector('.nav-link');
            if (otherLink) otherLink.setAttribute('aria-expanded', 'false');
          }
        });

        /* Abre o cierra el actual */
        if (isOpen) {
          item.classList.remove('is-open');
          link.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          link.setAttribute('aria-expanded', 'true');
        }
      });
    });

    /* ── Reset al redimensionar a desktop ──────────────────── */
    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        if (window.innerWidth >= 1024) {
          closeMenu();
        }
      }, 150);
    });

    console.log('INDUMIL Menú: inicializado correctamente ✓');
    return true;
  }

  /* ══════════════════════════════════════════════════════════
     ESTRATEGIA DE INICIALIZACIÓN MÚLTIPLE
     Elementor a veces inyecta el HTML tarde,
     por eso intentamos en varios momentos.
     ══════════════════════════════════════════════════════════ */

  var intentos = 0;
  var maxIntentos = 10;

  function intentarInit() {
    intentos++;
    var exito = initIndumilMenu();

    /* Si falló y no hemos agotado intentos, reintenta cada 200ms */
    if (!exito && intentos < maxIntentos) {
      setTimeout(intentarInit, 200);
    }
  }

  /* Intento 1: cuando el DOM está listo */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', intentarInit);
  } else {
    /* El DOM ya estaba listo (script cargado tarde) */
    intentarInit();
  }

  /* Intento 2: cuando todo (imágenes, Elementor) termina de cargar */
  window.addEventListener('load', function () {
    if (intentos === 0 || !document.getElementById('nav-menu')) {
      intentarInit();
    }
  });

  /* Intento 3: hook de Elementor por si usa su propio evento */
  document.addEventListener('elementor/frontend/init', function () {
    intentarInit();
  });
})();
</script>

